# Copy to an ignored local file and replace placeholders. Never commit secrets.
RP_SERVER_CATALOG_IDS=server-a
RP_SERVER_SERVER_A_HOST=<server-host>
RP_SERVER_SERVER_A_PORT=<ssh-port>
RP_SERVER_SERVER_A_USER=<ssh-user>
RP_SERVER_SERVER_A_KEY_PATH=<absolute-local-private-key-path>
# Optional explicit OpenSSH config / executable overrides.
RP_SERVER_SERVER_A_SSH_CONFIG=<absolute-local-ssh-config-path>
# RP_SERVER_SERVER_A_SSH=ssh
# RP_SERVER_SERVER_A_SCP=scp
# RP_SERVER_SERVER_A_SSH_COMMAND_TIMEOUT_SECONDS=120
# RP_SERVER_SERVER_A_SSH_TRANSFER_TIMEOUT_SECONDS=1800
# RP_SERVER_SERVER_A_SSH_REPOSITORY_TIMEOUT_SECONDS=1800

# Remote lifecycle paths are explicit and are verified by server qualification.
RP_SERVER_SERVER_A_PLATFORM_ROOT=<absolute-remote-platform-root>
RP_SERVER_SERVER_A_RELEASE_ROOT=<absolute-remote-release-root>
RP_SERVER_SERVER_A_OPERATOR_CWD=<absolute-remote-operator-cwd>
RP_SERVER_SERVER_A_REPOSITORY_ROOT=<absolute-remote-repository-root>
RP_SERVER_SERVER_A_OPERATOR_SHELL=/bin/sh
RP_SERVER_SERVER_A_REMOTE_ENV=/usr/bin/env
RP_SERVER_SERVER_A_SHA256SUM=/usr/bin/sha256sum
RP_SERVER_SERVER_A_PYTHON=<absolute-remote-python>
RP_SERVER_SERVER_A_PYTHON_SHA256=<sha256>
RP_SERVER_SERVER_A_PYTHON_PACKAGES_SHA256=<sha256>

RP_SERVER_SERVER_A_NODE=<absolute-remote-node-or-provider-runtime>
RP_SERVER_SERVER_A_NODE_SHA256=<sha256>
RP_SERVER_SERVER_A_JAVA=<absolute-remote-java-or-provider-runtime>
RP_SERVER_SERVER_A_JAVA_SHA256=<sha256>
RP_SERVER_SERVER_A_PLATFORM_MANAGE=<absolute-remote-platform-manage>
RP_SERVER_SERVER_A_PLATFORM_MANAGE_SHA256=<sha256>
RP_SERVER_SERVER_A_TMUX=<absolute-remote-tmux>
RP_SERVER_SERVER_A_TMUX_SHA256=<sha256>
RP_SERVER_SERVER_A_TMUX_SERVER_LABEL=noetrium
RP_SERVER_SERVER_A_TMUX_CONFIG=/dev/null
RP_SERVER_SERVER_A_TMUX_SOCKET_DIRECTORY=/tmp
RP_SERVER_SERVER_A_SESSION_NAME=noetrium-shell
RP_SERVER_SERVER_A_LOCAL_BINDING_ROOT=<absolute-local-state-dir>/server-sessions/server-a
RP_SERVER_SERVER_A_REMOTE_HOME=<absolute-remote-home>
RP_SERVER_SERVER_A_REMOTE_PATH=<explicit-remote-path>
RP_SERVER_SERVER_A_TERM=xterm-256color
