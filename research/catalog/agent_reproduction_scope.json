  "scope": "all_agent_related_research",
  "rules": {
    "priority_is_not_exclusion": true,
    "historical_to_current": true,
    "continuous_frontier_intake": true,
    "external_repositories_are_references_only": true,
    "promotion_rule": "Every discovered item that materially changes agent perception, state, memory, context, reasoning, planning, action, learning, tool use, coordination, embodiment, human interaction, safety, evaluation, environment integration or runtime execution enters the reproduction backlog. Paper-specific semantics remain reproduction-owned; reusable cross-method mechanisms may be promoted upstream only with evidence from real reproductions."
  },
  "required_domains": [
    {"domain_id":"classical-agent-architectures","title":"Classical, reactive, deliberative, BDI, blackboard, behavior-tree and hybrid agent architectures"},
    {"domain_id":"agent-loop","title":"Language-agent loops, cognition runtimes and planner-executor-verifier architectures"},
    {"domain_id":"reasoning","title":"Reasoning, decomposition, verification and deliberation"},
    {"domain_id":"planning-search","title":"Planning, tree/graph search, MCTS and test-time search"},
    {"domain_id":"world-models","title":"World models, model-based planning and foresight"},
    {"domain_id":"tool-use","title":"Function calling, API use, tool learning, routing and tool creation"},
    {"domain_id":"retrieval-knowledge","title":"RAG, agentic retrieval, knowledge graphs and evidence-grounded retrieval"},
    {"domain_id":"memory","title":"Working, episodic, semantic, procedural, vector, graph, hierarchical and learned memory"},
    {"domain_id":"context-management","title":"Context projection, compression, admission, eviction and long-horizon context"},
    {"domain_id":"reflection-self-correction","title":"Reflection, critique, verifier-guided correction and iterative refinement"},
    {"domain_id":"self-improvement","title":"Self-evolution, scaffold evolution, skills, curriculum and lifelong adaptation"},
    {"domain_id":"training","title":"Agent SFT, preference learning, RL, process/outcome rewards, online RL and self-play"},
    {"domain_id":"web-agents","title":"Browser, web navigation, web research and transactional web agents"},
    {"domain_id":"gui-computer-use","title":"Desktop, mobile and general GUI/computer-use agents"},
    {"domain_id":"software-engineering","title":"Coding, debugging, repository, issue-resolution and DevOps agents"},
    {"domain_id":"multimodal","title":"Vision, audio, video, document and arbitrary multimodal agents"},
    {"domain_id":"embodied-robotics","title":"Embodied navigation, manipulation, VLA and robotics agents"},
    {"domain_id":"game-worlds","title":"Minecraft, games, simulators, interactive fiction and open-world agents"},
    {"domain_id":"multi-agent","title":"Coordination, communication, debate, delegation, role specialization and collective intelligence"},
    {"domain_id":"protocols-interoperability","title":"MCP, A2A, schemas, discovery, delegation and cross-framework interoperability"},
    {"domain_id":"scientific-research","title":"Scientific discovery, literature, experiments, theorem/proof and AI-scientist agents"},
    {"domain_id":"enterprise-workflow","title":"Data, SQL, office, customer-service and enterprise workflow agents"},
    {"domain_id":"human-agent-interaction","title":"Mixed initiative, delegation, clarification, oversight, preferences and interruption"},
    {"domain_id":"social-economic","title":"Negotiation, markets, social simulation and mechanism-design agents"},
    {"domain_id":"safety-security","title":"Permissions, prompt injection, memory poisoning, sandboxing, trust and defensive security evaluation"},
    {"domain_id":"evaluation-benchmarks","title":"Agent benchmarks, judges, trajectory evaluation, reliability and efficiency"},
    {"domain_id":"runtime-systems","title":"Scheduling, checkpoints, recovery, concurrency, budgets, caching and observability"},
    {"domain_id":"environment-interfaces","title":"Text worlds, web, GUI, code, simulators, robotics and real-world environment adapters"}
  ],
