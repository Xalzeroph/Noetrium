#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
ENV_BOOTSTRAP="$ROOT/deploy/build-environments.sh"
ROOTLESS_DOCKER="$ROOT/deploy/rootless-docker.sh"
STATE_ROOT="${NOETRIUM_DEPLOYMENT_STATE_ROOT:-$ROOT/.noetrium/deployment}"
ENV_WORK_ROOT="$STATE_ROOT/environment-images"
FLEET_STATE_ROOT="$STATE_ROOT/reproduction-fleet"
BOOTSTRAP_READY=0

usage() {
  cat <<'EOF'
Usage: ./deploy/noetrium <doctor|build|plan|requirements|preflight|run|project|env|docker> [args]

  doctor     verify ordinary-user Docker/Compose access and environment registry
  build      build or reuse all active environment profiles
  plan       compile the repository reproduction fleet without starting work
  requirements emit the machine-readable owner authority prerequisite manifest
  preflight  materialize exact authority closure and admit the fleet without starting work
  run        build/reuse environments and execute one or many Research OS projects through the shared portfolio runtime
  project    create/sync/doctor/test downstream project sources; execution uses run
  env        pass remaining arguments to the low-level environment bootstrap
  docker     manage the optional ordinary-user rootless Docker daemon

Configuration:
  NOETRIUM_FLEET_AUTHORITY_MATERIALIZER=module:factory  # optional advanced override
  NOETRIUM_DEPLOYMENT_STATE_ROOT=/writable/path
  NOETRIUM_CONTROL_ENV_FILE=/path/to/env-file
  NOETRIUM_CONTROL_INPUT_ROOT=/read-only/authority-assets
  NOETRIUM_SKIP_ENVIRONMENT_BUILD=1
  NOETRIUM_DOCKER_DATA_ROOT=/data/noetrium/docker
  NOETRIUM_DOCKER_RUNTIME_ROOT=/data/noetrium/docker-runtime
EOF
}

die() {
  echo "noetrium-deploy: $*" >&2
  exit 2
}

host_doctor() {
  command -v docker >/dev/null 2>&1 || die "Docker CLI is required on the host"
  docker info >/dev/null 2>&1 || die "ordinary user cannot reach the active Docker daemon"
  docker compose version >/dev/null 2>&1 || die "Docker Compose plugin is required"
  mkdir -p "$ENV_WORK_ROOT" "$FLEET_STATE_ROOT"

  if [ -n "${NOETRIUM_DOCKER_DATA_ROOT:-}" ]; then
    mkdir -p "$NOETRIUM_DOCKER_DATA_ROOT"
    expected="$(CDPATH= cd -- "$NOETRIUM_DOCKER_DATA_ROOT" && pwd -P)"
    actual="$(docker info --format '{{.DockerRootDir}}')"
    actual_parent="$(dirname "$actual")"
    actual_name="$(basename "$actual")"
    if [ -d "$actual_parent" ]; then
      actual="$(CDPATH= cd -- "$actual_parent" && pwd -P)/$actual_name"
    fi
    [ "$actual" = "$expected" ] || die "active DockerRootDir does not match NOETRIUM_DOCKER_DATA_ROOT: expected=$expected actual=$actual"
  fi
}

authority_materializer_from_env_file() {
  file="${NOETRIUM_CONTROL_ENV_FILE:-$ROOT/deploy/.env}"
  [ -f "$file" ] || return 0
  sed -n 's/^NOETRIUM_FLEET_AUTHORITY_MATERIALIZER=//p' "$file" | tail -n 1
}

control_input_root_from_env_file() {
  file="${NOETRIUM_CONTROL_ENV_FILE:-$ROOT/deploy/.env}"
  [ -f "$file" ] || return 0
  sed -n "s/^NOETRIUM_CONTROL_INPUT_ROOT=//p" "$file" | tail -n 1
}

authority_materializer() {
  if [ -n "${NOETRIUM_FLEET_AUTHORITY_MATERIALIZER:-}" ]; then
    printf '%s\n' "$NOETRIUM_FLEET_AUTHORITY_MATERIALIZER"
    return 0
  fi
  authority_materializer_from_env_file
}

authority_requirements_path() {
  printf '%s\n' "$FLEET_STATE_ROOT/authority-prerequisites.json"
}

emit_authority_requirements() {
  path="$(authority_requirements_path)"
  mkdir -p "$FLEET_STATE_ROOT"
  fleet --requirements --output "$path"
  printf 'noetrium_authority_requirements=%s\n' "$path"
}


fleet_with_optional_materializer() {
  materializer="$(authority_materializer)"
  if [ -n "$materializer" ]; then
    fleet "$@" --authority-materializer "$materializer"
  else
    fleet "$@"
  fi
}

environment_bootstrap() {
  NOETRIUM_BUILD_WORK_ROOT="$ENV_WORK_ROOT" "$ENV_BOOTSTRAP" "$@"
  BOOTSTRAP_READY=1
}

control_python() {
  input_root="${NOETRIUM_CONTROL_INPUT_ROOT:-}"
  if [ -z "$input_root" ]; then
    input_root="$(control_input_root_from_env_file)"
  fi
  if [ -n "$input_root" ]; then
    export NOETRIUM_CONTROL_INPUT_ROOT="$input_root"
  fi
  if [ "$BOOTSTRAP_READY" = "1" ]; then
    NOETRIUM_BOOTSTRAP_REUSE=1 \
      NOETRIUM_BUILD_WORK_ROOT="$ENV_WORK_ROOT" \
      NOETRIUM_CONTROL_STATE_ROOT="$FLEET_STATE_ROOT" \
      "$ENV_BOOTSTRAP" control "$@"
  else
    NOETRIUM_BUILD_WORK_ROOT="$ENV_WORK_ROOT" \
      NOETRIUM_CONTROL_STATE_ROOT="$FLEET_STATE_ROOT" \
      "$ENV_BOOTSTRAP" control "$@"
    BOOTSTRAP_READY=1
  fi
}

fleet() {
  control_python scripts/run_reproduction_fleet.py "$@"
}

run_has_project_selector() {
  for argument in "$@"; do
    case "$argument" in
      --project|--project=*)
        return 0
        ;;
    esac
  done
  return 1
}

project_root_from_args() {
  project_root="."
  expect_root=0
  for argument in "$@"; do
    if [ "$expect_root" = "1" ]; then
      project_root="$argument"
      expect_root=0
      continue
    fi
    case "$argument" in
      --project)
        expect_root=1
        ;;
      --project=*)
        project_root="${argument#--project=}"
        ;;
    esac
  done
  [ "$expect_root" = "0" ] || die "--project requires a path"
  test -d "$project_root" || die "project root does not exist: $project_root"
  test ! -L "$project_root" || die "project root must not be a symlink: $project_root"
  (CDPATH= cd -- "$project_root" && pwd -P)
}

project_control() {
  [ "$#" -gt 0 ] || die "project requires a Research OS lifecycle command"
  action="$1"
  project_root="$(project_root_from_args "$@")"
  project_state_root="$project_root/.noetrium/control-plane"
  mkdir -p "$project_state_root"

  case "$action" in
    doctor|test|sync)
      set -- project "$@"
      ;;
    run|inspect|pause|drain|interrupt|resume|retry|cancel|checkpoint|reconcile|migrate)
      ;;
    *)
      die "unsupported project control action: $action"
      ;;
  esac

  bootstrap_reuse=0
  if [ "$BOOTSTRAP_READY" = "1" ]; then
    bootstrap_reuse=1
  fi

  NOETRIUM_BOOTSTRAP_REUSE="$bootstrap_reuse" \
  NOETRIUM_CONTROL_PROJECT_ROOT="$project_root" \
  NOETRIUM_CONTROL_HOST_RUNTIME=1 \
  NOETRIUM_CONTROL_STATE_ROOT="$project_state_root" \
  NOETRIUM_BUILD_WORK_ROOT="$ENV_WORK_ROOT" \
    "$ENV_BOOTSTRAP" control \
      -c 'from noetrium_platform.composition.operator.wiring.research import main; import sys; raise SystemExit(main(sys.argv[1:]))' \
      "$@"
}

command="${1:-}"
[ -n "$command" ] || {
  usage
  exit 2
}
shift

case "$command" in
  doctor)
    host_doctor
    environment_bootstrap validate
    echo "noetrium_deployment_ready=true"
    ;;
  build)
    host_doctor
    environment_bootstrap build "$@"
    ;;
  plan)
    host_doctor
    fleet "$@" --state-root "$FLEET_STATE_ROOT"
    ;;
  requirements)
    host_doctor
    emit_authority_requirements
    ;;
  preflight)
    host_doctor
    fleet_with_optional_materializer --preflight \
      --state-root "$FLEET_STATE_ROOT" "$@"
    ;;
  run)
    host_doctor
    if [ "${NOETRIUM_SKIP_ENVIRONMENT_BUILD:-0}" != "1" ]; then
      environment_bootstrap build
    fi
    if run_has_project_selector "$@"; then
      project_control run "$@"
    else
      fleet_with_optional_materializer --execute \
        --state-root "$FLEET_STATE_ROOT" "$@"
    fi
    ;;
  project)
    host_doctor
    if [ "${1:-}" = "run" ]; then
      die "project run was removed; use ./deploy/noetrium run --project <path>"
    fi
    project_control "$@"
    ;;
  env)
    host_doctor
    environment_bootstrap "$@"
    ;;
  docker)
    [ "$#" -gt 0 ] || die "docker requires doctor|start|status|stop|env"
    "$ROOTLESS_DOCKER" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    die "unknown command: $command"
    ;;
esac
