# Immutable evidence-bound base image. Build this image from a formally
# qualified wheel/context; environment images consume it by tag or digest.
PLATFORM_IMAGE=noetrium:local

# Host-owned mutable runtime data.
PLATFORM_HOST_DATA_ROOT=./.runtime

# Optional reusable environment images. These contain only generic execution
# prerequisites; benchmarks, paper methods, task manifests and checkpoints stay
# downstream.
PLATFORM_MINECRAFT_IMAGE=noetrium-env-minecraft:local
PLATFORM_EMBODIED_IMAGE=noetrium-env-embodied:local
PLATFORM_GUI_IMAGE=noetrium-env-gui:local
PLATFORM_WEB_IMAGE=noetrium-env-web:local
PLATFORM_SOFTWARE_IMAGE=noetrium-env-software:local

NODE_VERSION=22.22.2

# Preferred owner-system authority materializer for repository fleet runs.
# It consumes content-addressed fleet requirement manifests through prerequisite,
# ProjectManifest, and execution-owner stages, returning exact typed registries
# without paper-specific Python wiring.
# Format: Python module:factory(context) returning
# ReproductionFleetAuthorityMaterializerPort. The context carries the one
# ManagedResearchRuntime, shared execution pool and Resource authorities.
NOETRIUM_FLEET_AUTHORITY_MATERIALIZER=

# Optional read-only host root containing benchmark/model authority assets used
# by the control-plane materializer. It is mounted at the same absolute path.
NOETRIUM_CONTROL_INPUT_ROOT=

# Optional: move every persistent/high-volume Noetrium runtime artifact under
# one writable data root. Deployment state, environment build state and project
# Research OS state derive from this root unless a narrower override is supplied.
# NOETRIUM_DATA_ROOT=/data/noetrium
# NOETRIUM_DEPLOYMENT_STATE_ROOT=/data/noetrium/deployment
# NOETRIUM_BUILD_WORK_ROOT=/data/noetrium/environment-images

# Optional ordinary-user rootless Docker state. Use these when the system
# DockerRootDir is on a small/full filesystem.
# NOETRIUM_DOCKER_DATA_ROOT=/data/noetrium/docker
# NOETRIUM_DOCKER_RUNTIME_ROOT=/data/noetrium/docker-runtime
