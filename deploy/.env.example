# Immutable platform image. Production automation should use an exact release
# or source-revision-derived tag/digest rather than a mutable convenience tag.
PLATFORM_IMAGE=noetrium:local

# Host-owned mutable runtime data. Choose a durable disk appropriate for the
# deployment; this value is intentionally machine-specific and should normally
# be supplied from an ignored local environment file.
PLATFORM_HOST_DATA_ROOT=./.runtime

# Optional bundled Minecraft provider image/runtime.
PLATFORM_MINECRAFT_IMAGE=noetrium-minecraft:local
NODE_VERSION=22.22.2
