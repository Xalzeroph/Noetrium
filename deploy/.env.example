# Immutable evidence-bound base image. Build this image from a formally
# qualified wheel/context; environment images consume it by tag or digest.
PLATFORM_IMAGE=noetrium:local

# Host-owned mutable runtime data.
PLATFORM_HOST_DATA_ROOT=./.runtime

# Optional reusable environment images. These contain only generic execution
# prerequisites; benchmarks, paper methods, task manifests and checkpoints stay
# downstream.
PLATFORM_MINECRAFT_IMAGE=noetrium-env-minecraft:local
PLATFORM_EMBODIED_IMAGE=noetrium-env-embodied:local
PLATFORM_GUI_IMAGE=noetrium-env-gui:local
PLATFORM_WEB_IMAGE=noetrium-env-web:local
PLATFORM_SOFTWARE_IMAGE=noetrium-env-software:local

NODE_VERSION=22.22.2

# Preferred owner-system authority materializer for repository fleet runs.
# It consumes content-addressed fleet requirement manifests and returns exact
# typed owner registries without paper-specific Python wiring.
# Format: Python module:factory returning ReproductionFleetAuthorityMaterializerPort.
NOETRIUM_FLEET_AUTHORITY_MATERIALIZER=

# Optional low-level override returning a fully composed
# ReproductionFleetExecutionAuthorities bundle. Prefer the materializer above.
NOETRIUM_FLEET_EXECUTION_AUTHORITY=

# Optional: move writable deployment/fleet state outside the checkout.
# NOETRIUM_DEPLOYMENT_STATE_ROOT=/data/noetrium
